# ==============================================================================
# Woka Reel Intelligence — Local Development Environment Configuration (.env)
# ==============================================================================
# Copy this file to backend/.env for local development.
# Run backend with: uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload

ENVIRONMENT=development
DEBUG=True
PROJECT_NAME="Woka API"
VERSION="1.0.0"
API_V1_STR=/api/v1

# Frontend URL (Where your local Next.js app runs)
FRONTEND_URL=http://localhost:3000

# ==============================================================================
# Cryptographic Keys (Local Development Defaults)
# ==============================================================================
SECRET_KEY=woka-dev-secret-key-at-least-32-chars-long-2026
TOKEN_ENCRYPTION_KEY=N0NlbmRfdG9rZW5fZW5jcnlwdGlvbl9zdGFnaW5nOTk=
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# ==============================================================================
# Database Configuration
# ==============================================================================
# Option A: Local PostgreSQL (via Docker Compose: docker compose up -d postgres redis)
DATABASE_URL=postgresql://woka:woka_dev_password_2026@localhost:5432/woka_reel_intelligence

# Option B: Fallback SQLite (No Docker required)
# DATABASE_URL=sqlite:///./woka.db

# ==============================================================================
# Redis Configuration (For rate limiting & background workers)
# ==============================================================================
REDIS_URL=redis://localhost:6379/0

# ==============================================================================
# ngrok Public HTTPS URL (CRITICAL for Meta Instagram OAuth & Webhooks)
# ==============================================================================
# Start ngrok in a separate terminal: ngrok http 8000
# Paste your assigned ngrok HTTPS forwarding URL below (NO trailing slash):
# Example: https://uncommon-tiger-prompt.ngrok-free.app
BACKEND_PUBLIC_URL=https://YOUR-NGROK-DOMAIN.ngrok-free.app

# Official Meta Redirect URI
# When BACKEND_PUBLIC_URL is provided, Woka dynamically resolves this to:
# {BACKEND_PUBLIC_URL}/api/v1/instagram/callback
# You can also set it explicitly:
META_REDIRECT_URI=https://YOUR-NGROK-DOMAIN.ngrok-free.app/api/v1/instagram/callback

# ==============================================================================
# Meta Developer Portal Credentials (Instagram Login for Business)
# ==============================================================================
# 1. Register at https://developers.facebook.com
# 2. Create an App > Type: "Business" or "Other" > Add "Instagram Graph API"
# 3. Add Instagram App ID & App Secret below:
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret

# Webhook Verification Token (Choose any secure random string, match in Meta App Dashboard)
META_VERIFY_TOKEN=woka_local_webhook_verify_token_2026
META_API_VERSION=v21.0

# ==============================================================================
# CORS & Allowed Hosts
# ==============================================================================
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000", "http://localhost:8000", "http://127.0.0.1:8000"]
ALLOWED_HOSTS=["*"]

# ==============================================================================
# Optional AI Provider (Optional: fallback uses Woka's built-in NLP heuristics)
# ==============================================================================
OPENAI_API_KEY=
